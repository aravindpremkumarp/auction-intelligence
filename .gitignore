# Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
.venv-*/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/
build/
dist/

# Local generated output (scraping / reports / data / caches)
downloads/
reports/
data/
output/
pipeline/cache/
pipeline/output/
output/
screenshots/
*.log
~$*                   # Windows Office temp files

# Claude Code per-project / per-user settings
.claude/*
!.claude/skills/
!.claude/settings.json
!.claude/hooks/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Node (Vercel may create these locally)
node_modules/
.vercel/
.next/
.gstack/

# Poster agent staged-run scratch dir (marketing_agents/poster.py)
.poster_work/

# Reporter agent staged-run scratch dir (marketing_agents/reporter.py)
.reporter_work/

# HyperFrames video-production workspace (local: node_modules + renders;
# production templates get promoted into tracked dirs when ready)
videos/

# Channel-research pulls (marketing/research/) — scraped media + CSVs.
# (Already covered by the broad data/ rule above; listed for self-documentation.)
marketing/research/data/

# LangExtract precision-eval extraction cache (regenerated on demand)
evals/.prf_cache.json

# Local scratch for scripts/generate_property_og.py (cards live in R2, not git)
.og_renders/
# render_social.py stages a template beside the real one to inject the data
# island, and deletes it on a clean exit — a crashed or killed run leaves it
# behind. Pure scratch either way, never content.
marketing/templates/.*.staged.html

# Staged social media renders go to R2, not git — a weekly batch of card PNGs
# accumulates forever (the same reason the property OG cards live in R2). Their
# keys are recorded in the batch's drafts.json, which IS committed.
# Already-committed batches stay tracked; this only stops new ones.
marketing/outputs/*/rendered/
.reel_renders/
