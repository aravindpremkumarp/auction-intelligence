# Vercel only needs the static web/ contents and vercel.json.
# Ignore everything else by default to keep the deploy bundle small.
# Without this, Vercel was bundling .venv/, downloads/ (17GB), data/ (1.2GB),
# etc. and blowing past Lambda's 500MB ephemeral storage limit.

# Ignore everything
*

# Allow what the deploy actually needs
!web
!web/**
!vercel.json
