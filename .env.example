# Copy this file to .env and fill in the real values. Never commit .env.

# FindAuction scraping credentials (LOCAL ONLY - not needed in production)
FINDAUCTION_EMAIL=
FINDAUCTION_PASSWORD=

# OpenRouter API (vision LLM for OCR + entity extraction)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Neo4j Aura
CLIENT_SECRET=
CLIENT_ID=
CLIENT_NAME=Bank Auction Intelligence
NEO4J_URI=neo4j+s://<your-instance>.databases.neo4j.io
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
AURA_INSTANCEID=
AURA_INSTANCENAME=

# OpenAI (backup LLM)
OPENAI_API_KEY=

# Auth (JWT)
JWT_SECRET=
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM="Bank Auction <no-reply@example.com>"

# App
APP_BASE_URL=http://localhost:5173
APP_ENV=dev
ADMIN_BOOTSTRAP_EMAIL=
AUTH_ENABLED=true
RATELIMIT_DISABLED=
