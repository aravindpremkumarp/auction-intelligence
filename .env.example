# Copy this file to .env and fill in the real values. Never commit .env.

# FindAuction scraping credentials (LOCAL ONLY - not needed in production)
FINDAUCTION_EMAIL=
FINDAUCTION_PASSWORD=

# OpenRouter API (vision LLM for OCR + entity extraction)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Neo4j Aura
CLIENT_SECRET=
CLIENT_ID=
CLIENT_NAME=Bank Auction Intelligence
NEO4J_URI=neo4j+s://<your-instance>.databases.neo4j.io
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
AURA_INSTANCEID=
AURA_INSTANCENAME=

# OpenAI (backup LLM)
OPENAI_API_KEY=

# Google Gemini (required for semantic_search — gemini-embedding-2 vectors).
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Supabase Auth
# The backend verifies access tokens via JWKS at ${SUPABASE_URL}/auth/v1/.well-known/jwks.json.
# ANON key is safe to expose to the browser. Service role key is server-only; used by scripts/create_admin.py
# to look up a user by email before promoting them to admin in Neo4j.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Observability — Pydantic Logfire (OpenTelemetry tracing of the chat agent,
# LLM calls, and tool calls). Leave LOGFIRE_TOKEN blank to disable tracing
# (the app degrades to the structured logs in api/observability.py).
# Create a project + write token at https://logfire.pydantic.dev
LOGFIRE_TOKEN=
LOGFIRE_ENVIRONMENT=dev
# Optional: to send traces to a non-Logfire OTLP backend (LangSmith, Langfuse,
# Honeycomb, …) instead, leave LOGFIRE_TOKEN blank and set the standard OTel
# env vars, e.g. OTEL_EXPORTER_OTLP_ENDPOINT / OTEL_EXPORTER_OTLP_HEADERS.

# Evaluation (evals/run_golden.py) — judge model for the LLM-as-judge answer-
# quality score. Defaults to OPENROUTER_MODEL; set a stronger/independent model
# to reduce self-grading bias, e.g. anthropic/claude-sonnet-4.5.
EVAL_JUDGE_MODEL=

# App
APP_BASE_URL=http://localhost:5173
APP_ENV=dev
ADMIN_BOOTSTRAP_EMAIL=
AUTH_ENABLED=true
RATELIMIT_DISABLED=
# Max /chat turns per authenticated user per day (LLM cost guard; default 200).
CHAT_USER_DAILY_LIMIT=

# Pipeline (local batch runs)
# Log level for pipeline.obs structured logs (default INFO).
PIPELINE_LOG_LEVEL=
# Abort a batch LLM run once total tokens exceed this (unset = no cap).
PIPELINE_LLM_TOKEN_BUDGET=

# Cloudflare R2 (public bucket that serves auction sales notices to the web UI)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=auction-downloads
# Public base URL for the bucket (e.g. https://pub-xxxx.r2.dev or a custom domain).
# Objects are served at f"{R2_PUBLIC_BASE_URL}/{storage_key}".
R2_PUBLIC_BASE_URL=

# Cloudflare R2 (PRIVATE bucket for confidential user dossier documents).
# Never made public — reads go through short-TTL presigned URLs. Uses the same
# R2 account credentials above; only the bucket name differs.
R2_PRIVATE_BUCKET=auction-dossiers

# MinerU OCR (https://mineru.net) — layout-aware OCR for notices + dossier docs.
MINERU_API_KEY=

# Doc-type classifier for the dossier locker (defaults to google/gemini-2.5-flash).
OPENROUTER_MODEL_DOC_CLASSIFY=
